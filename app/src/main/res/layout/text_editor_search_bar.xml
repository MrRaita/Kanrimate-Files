<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="4dp">

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/searchBarInput"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@null"
        android:hint="@string/text_editor_find_hint"
        android:importantForAutofill="no"
        android:imeOptions="actionSearch|flagNoExtractUi"
        android:inputType="text"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="?android:attr/textColorPrimary"
        android:textColorHint="?android:attr/textColorSecondary"
        android:textSize="16sp" />

    <ImageButton
        android:id="@+id/searchBarPrevious"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/text_editor_find_previous"
        android:src="@drawable/text_editor_search_up_24dp" />

    <ImageButton
        android:id="@+id/searchBarNext"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/text_editor_find_next"
        android:src="@drawable/text_editor_search_down_24dp" />

    <TextView
        android:id="@+id/searchBarCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="52dp"
        android:gravity="center"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/searchBarClose"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/text_editor_find_close"
        android:src="@drawable/text_editor_search_close_24dp" />
</LinearLayout>
